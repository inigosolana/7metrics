# Kaggle API (obligatorio para POST /api/process-gpu)
# Crear cuenta en https://www.kaggle.com → Account → Create New API Token (descarga kaggle.json)
# Luego copia el username y la key a estas variables (nunca subas kaggle.json al repo).
KAGGLE_USERNAME=tu_usuario_kaggle
KAGGLE_KEY=tu_api_key_de_kaggle

# URL pública del backend (para que el worker en Kaggle pueda descargar el vídeo y llamar al webhook)
# En local usa ngrok o similar: ngrok http 8000 → pega aquí la URL https
WEBHOOK_BASE_URL=http://localhost:8000
